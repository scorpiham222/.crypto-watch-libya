index.html
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#08111f">
<title>مرصد الكريبتو ليبيا</title>
<style>
body{margin:0;background:#08111f;color:#eef5ff;font-family:Arial,sans-serif;padding:18px}
h1{color:#56ddb0;font-size:25px}
p{color:#a9bbd0}
section{background:#122238;border:1px solid #2a405b;border-radius:15px;padding:14px;margin:12px 0}
.coin{display:flex;justify-content:space-between;gap:10px;border-bottom:1px solid #2a405b;padding:12px 0}
input,button,select{font:inherit;padding:11px;border-radius:9px;border:1px solid #344c68;margin:5px 0;max-width:100%}
input,select{background:#091625;color:white}
button{background:#14785d;color:white;cursor:pointer}
.small{font-size:12px;color:#a9bbd0}
.price{direction:ltr;font-weight:bold}
</style>
</head>
<body>
<h1>₿ مرصد الكريبتو ليبيا</h1>
<p>أسعار السوق والأحداث المهمة — توقيت ليبيا</p>

<section>
<h2>أسعار العملات بالدولار</h2>
<div id="prices">جاري تحميل الأسعار…</div>
<button onclick="loadPrices()">تحديث الأسعار</button>
<p class="small" id="updated"></p>
</section>

<section>
<h2>أضف حدثاً وتنبيهاً</h2>
<input id="eventName" placeholder="اسم الخبر أو الحدث">
<input id="eventDate" type="datetime-local">
<p class="small">حدد موعد الحدث حسب توقيت ليبيا.</p>
<label><input type="checkbox" class="lead" value="1440" checked> قبل 24 ساعة</label><br>
<label><input type="checkbox" class="lead" value="60" checked> قبل ساعة</label><br>
<label><input type="checkbox" class="lead" value="15" checked> قبل 15 دقيقة</label><br>
<label><input type="checkbox" class="lead" value="0" checked> عند الموعد</label><br>
<button onclick="addEvent()">حفظ الحدث</button>
<div id="events"></div>
</section>

<section>
<h2>مصادر الأخبار الرسمية</h2>
<p><a href="https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm">مواعيد الفيدرالي الأمريكي</a></p>
<p><a href="https://www.bls.gov/schedule/">التضخم والتوظيف الأمريكي</a></p>
<p><a href="https://www.bea.gov/news/schedule">الناتج المحلي وPCE</a></p>
<p><a href="https://www.coingecko.com/">أسعار العملات</a></p>
</section>

<p class="small">الأسعار تعتمد على اتصال الإنترنت. التنبيهات في هذا الإصدار تعمل عندما تكون الصفحة مفتوحة؛ لا تضمن التنبيه بعد إغلاقها. المعلومات ليست توصية استثمارية.</p>

<script>
const coins=[
['bitcoin','BTC','Bitcoin'],
['ethereum','ETH','Ethereum'],
['solana','SOL','Solana'],
['ripple','XRP','XRP'],
['binancecoin','BNB','BNB'],
['bonk','BONK','Bonk']
];
let events=JSON.parse(localStorage.getItem('lyEvents')||'[]');
let fired=JSON.parse(sessionStorage.getItem('lyFired')||'[]');

async function loadPrices(){
 const el=document.getElementById('prices');
 el.textContent='جاري تحميل الأسعار…';
 try{
  const ids=coins.map(c=>c[0]).join(',');
  const r=await fetch('https://api.coingecko.com/api/v3/simple/price?ids='+ids+'&vs_currencies=usd&include_24hr_change=true');
  if(!r.ok)throw Error('price error');
  const d=await r.json();
  el.innerHTML=coins.map(c=>{
   const x=d[c[0]];
   if(!x)return '';
   const change=x.usd_24h_change||0;
   return '<div class="coin"><div><b>'+c[1]+'</b><br><span class="small">'+c[2]+'</span><br><span class="small">'+(change>=0?'+':'')+change.toFixed(2)+'% خلال 24 ساعة</span></div><div class="price">$'+Number(x.usd).toLocaleString('en-US',{maximumFractionDigits:8})+'</div></div>';
  }).join('');
  document.getElementById('updated').textContent='آخر تحديث: '+new Date().toLocaleTimeString('ar-LY',{timeZone:'Africa/Tripoli'});
 }catch(e){el.textContent='تعذر تحميل الأسعار. اضغط تحديث بعد قليل.'}
}
function save(){localStorage.setItem('lyEvents',JSON.stringify(events))}
function addEvent(){
 const name=document.getElementById('eventName').value.trim();
 const date=document.getElementById('eventDate').value;
 if(!name||!date){alert('اكتب اسم الحدث وحدد موعده');return}
 events.push({id:Date.now().toString(),name,date:new Date(date).toISOString(),leads:[...document.querySelectorAll('.lead:checked')].map(x=>+x.value)});
 save();renderEvents();
 document.getElementById('eventName').value='';
 document.getElementById('eventDate').value='';
 if('Notification'in window&&Notification.permission==='default')Notification.requestPermission();
}
function renderEvents(){
 const box=document.getElementById('events');
 if(!events.length){box.innerHTML='<p class="small">ما فيش أحداث محفوظة. أضف أول حدث من فوق.</p>';return}
 box.innerHTML=events.sort((a,b)=>new Date(a.date)-new Date(b.date)).map(e=>'<div class="coin"><div><b>'+e.name.replace(/[&<>]/g,'')+'</b><br><span class="small">'+new Date(e.date).toLocaleString('ar-LY',{timeZone:'Africa/Tripoli'})+'</span></div><button onclick="removeEvent(\\''+e.id+'\\')">حذف</button></div>').join('');
}
function removeEvent(id){events=events.filter(e=>e.id!==id);save();renderEvents()}
function checkAlerts(){
 const now=Date.now();
 for(const e of events){
  const t=new Date(e.date).getTime();
  for(const lead of e.leads){
   const key=e.id+':'+lead;
   if(!fired.includes(key)&&now>=t-lead*60000&&now<t-lead*60000+20000){
    const msg=lead===0?'بدأ موعد: ':lead===1440?'باقي 24 ساعة على: ':lead===60?'باقي ساعة على: ':'باقي 15 دقيقة على: ';
    if('Notification'in window&&Notification.permission==='granted')new Notification('مرصد الكريبتو ليبيا',{body:msg+e.name});
    else alert(msg+e.name);
    fired.push(key);sessionStorage.setItem('lyFired',JSON.stringify(fired));
   }
  }
 }
}
loadPrices();setInterval(loadPrices,60000);
renderEvents();setInterval(checkAlerts,10000);
</script>
</body>
</html>
